{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "serper": {
      "type": "local",
      "command": ["npx", "-y", "serper-search-scrape-mcp-server"]
    }
  },
  "theme": "opencode",
  "mode": {
    "raw": {
      "prompt": "act natural",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true,
        "text_search": true,
        "glob": true,
        "patch": true,
        "todowrite": true,
        "todoread": true,
        "webfetch": true,
        "task": true
      }
    }
  },
  "provider": {
    "wandb": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "W&B Inference",
      "options": {
        "baseURL": "https://api.inference.wandb.ai/v1",
        "apiKey": "{env:WANDB_API_KEY}",
        "headers": {
          "OpenAI-Project": "pepperdas-pepper-music/terminal tools"
        }
      },
      "models": {
        "Qwen/Qwen3-Coder-480B-A35B-Instruct": {
          "name": "Qwen3 Coder 480B"
        }
      }
    },
    "zai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "z.ai",
      "options": {
        "baseURL": "https://api.z.ai/api/paas/v4/",
        "apiKey": "{env:ZAI_API_KEY}",
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "models": {
        "glm-4.5": {
          "name": "GLM 4.5"
        }
      }
    }
  },
  "model": "zai/glm-4.5"
}
