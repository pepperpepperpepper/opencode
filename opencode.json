{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "parasail": {
      "name": "Parasail",
      "env": ["PARASAIL_API_KEY"],
      "models": {
        "glm-4.5": {
          "name": "GLM-4.5",
          "release_date": "2025-07-28",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "cost": {
            "input": 0.2,
            "output": 1.1
          },
          "limit": {
            "context": 128000,
            "output": 96000
          },
          "options": {}
        }
      }
    },
    "openrouter": {
      "models": {
        "moonshotai/kimi-k2": {
          "options": {
            "provider": {
              "order": ["baseten"],
              "allow_fallbacks": false
            }
          }
        },
        "z-ai/glm-4.6": {
          "name": "GLM-4.6",
          "release_date": "2025-09-30",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "cost": {
            "input": 0.6,
            "output": 2.1
          },
          "limit": {
            "context": 202752,
            "output": 96000
          },
          "options": {}
        }
      }
    },
    "huggingface": {
      "models": {
        "Qwen/Qwen3-235B-A22B-Instruct-2507:fireworks-ai": {},
        "Qwen/Qwen3-Coder-480B-A35B-Instruct:fireworks-ai": {},
        "Qwen/Qwen3-32B:fireworks-ai": {},
        "Qwen/Qwen3-8B:fireworks-ai": {},
        "Qwen/Qwen3-14B:fireworks-ai": {},
        "Qwen/Qwen3-4B:fireworks-ai": {},
        "Qwen/Qwen3-1.7B:fireworks-ai": {},
        "Qwen/Qwen3-0.6B:fireworks-ai": {}
      }
    },
    "zai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.ai",
      "options": {
        "baseURL": "https://api.z.ai/api/paas/v4/",
        "apiKey": "{env:ZAI_API_KEY}",
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "models": {
        "glm-4.5": {
          "name": "GLM-4.5",
          "release_date": "2025-07-28",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "cost": {
            "input": 0.2,
            "output": 1.1
          },
          "limit": {
            "context": 128000,
            "output": 96000
          },
          "options": {}
        },

        "glm-4.6": {
          "name": "GLM-4.6",
          "release_date": "2025-09-30",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "cost": {
            "input": 0.25,
            "output": 1.2
          },
          "limit": {
            "context": 128000,
            "output": 96000
          },
          "options": {}
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/sse"
    },
    "weather": {
      "type": "local",
      "command": ["opencode", "x", "@h1deya/mcp-server-weather"]
    }
  }
}
